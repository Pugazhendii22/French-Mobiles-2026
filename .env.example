# Copy to .env and fill in. Never commit the real .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Read-only TAC (device model) lookup database - optional, powers scan-to-autofill
VITE_TAC_FIREBASE_API_KEY=
VITE_TAC_FIREBASE_AUTH_DOMAIN=
VITE_TAC_FIREBASE_PROJECT_ID=
VITE_TAC_FIREBASE_STORAGE_BUCKET=
VITE_TAC_FIREBASE_MESSAGING_SENDER_ID=
VITE_TAC_FIREBASE_APP_ID=

# Label print server on the shop PC (phones post labels here).
# Leave blank to use the built-in default of http://192.168.1.36:3000
VITE_PRINT_SERVER_URL=
